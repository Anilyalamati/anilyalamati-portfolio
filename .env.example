# Copy this file to `.env.local` for local development, and add the same
# variable in Vercel → Project → Settings → Environment Variables for
# production. `.env.local` is git-ignored; this example file is not.
#
# This variable is OPTIONAL. The site works fully without it — the contact
# form simply falls back to opening your email client (mailto).

# Public Formspree form id (the `xxxxxxxx` part of https://formspree.io/f/xxxxxxxx).
# This is NOT a secret: anything prefixed with VITE_ is shipped to the browser by design,
# and Formspree form ids are meant to be public. Never put a real secret/API key in a VITE_ variable.
VITE_FORMSPREE_FORM_ID=
